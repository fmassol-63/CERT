# Copiez ce fichier en ".env" et adaptez les valeurs, puis NE PAS commiter ".env".

# Adresse email utilisee par Let's Encrypt pour vous prevenir en cas de
# probleme avec un certificat (expiration proche, revocation, etc).
ACME_EMAIL=admin@printetreste.com

# Domaine(s) a proteger. Plusieurs domaines/sous-domaines peuvent etre
# separes par une virgule (ils partageront le meme certificat) :
# DOMAIN=www.printetreste.com, printetreste.com
DOMAIN=www.printetreste.com, printetreste.com

# Adresse (host:port) ou tourne actuellement l'application en HTTP.
# - Si l'appli tourne dans un autre conteneur Docker sur le meme reseau
#   "cert-net" : UPSTREAM=nom_du_conteneur:port
# - Si l'appli tourne directement sur la machine hote (hors Docker) :
#   UPSTREAM=host.docker.internal:80
UPSTREAM=printetreste-app:8080
