# Copiez ce fichier en ".env" et adaptez les valeurs, puis NE PAS commiter ".env".

# Adresse email utilisee par Let's Encrypt pour vous prevenir en cas de
# probleme avec un certificat (expiration proche, revocation, etc).
ACME_EMAIL=admin@printetreste.com

# Domaine(s) a proteger, separes par une virgule (meme certificat pour tous).
DOMAINS=www.printetreste.com,printetreste.com

# Mettre "true" pour utiliser l'environnement de test Let's Encrypt
# (staging) le temps de valider la configuration, sans consommer le quota
# de production. Repasser a "false" avant la mise en prod reelle.
STAGING=true

# Port publie par le conteneur acme-challenge, vers lequel HAProxy doit
# relayer les requetes /.well-known/acme-challenge/ (voir haproxy/snippet.cfg.example).
ACME_HTTP_PORT=8080
